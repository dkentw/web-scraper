# Normalize line endings to LF on commit for all text files
* text=auto eol=lf

# Source code
*.py    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.lock  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.rst   text eol=lf

# Shell scripts (must stay LF)
*.sh    text eol=lf

# Windows scripts (must stay CRLF)
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary files — no line ending conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.db    binary
*.sqlite binary
